+// A4 Q1: called from trap() on every timer tick taken while the current
+// process is running. Charges the tick to its remaining time and returns 1
+// if some RUNNABLE process now has a strictly smaller remaining time, i.e.
+// the current process must yield.
+int
+srtf_tick(void)
+{
+  struct proc *cur = myproc(), *p, *shorter = 0;
+
+  acquire(&ptable.lock);
+  if(cur->burst_time > 0 && cur->remaining_time > 0)
+    cur->remaining_time--;
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state == RUNNABLE && srtf_key(p) < srtf_key(cur) &&
+       (shorter == 0 || srtf_key(p) < srtf_key(shorter)))
+      shorter = p;
+  }
+  release(&ptable.lock);
+  return shorter != 0;
+}
+
+// A4 Q3: called from trap() on every timer tick taken while the current
+// process is running. Queue 0 gets a 1-tick slice, queue 1 two ticks and
+// queue 2 four ticks. A process that uses its whole slice is demoted one
+// level (queue 2 stays at 2) and must yield (returns 1).
+int
+mlfq_tick(void)
+{
+  static int slice[NQUEUE] = {1, 2, 4};
+  struct proc *cur = myproc();
+  int expired = 0;
+
+  acquire(&ptable.lock);
+  if(++cur->ticks_used >= slice[cur->queue_level]){
+    if(cur->queue_level < NQUEUE - 1){
+      cprintf("[mlfq] tick %d: pid %d used its %d-tick slice, queue %d -> %d\n",
+              ticks, cur->pid, slice[cur->queue_level], cur->queue_level, cur->queue_level + 1);
+      cur->queue_level++;
+    }
+    cur->ticks_used = 0;
+    expired = 1;
+  }
+  release(&ptable.lock);
+  return expired;
+}
+
+// A4 Q1/Q2: set the declared burst (ticks, >= 0; 0 clears it) of process
+// pid and restart its remaining time from it. Returns 0, or -1 if bt is
+// negative or there is no such process.
+int
+set_burst(int pid, int bt)
+{
+  struct proc *p;
+
+  if(bt < 0)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid && p->state != UNUSED){
+      p->burst_time = bt;
+      p->remaining_time = bt;
+      release(&ptable.lock);
+      return 0;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
+
+// A4 Q3: return the MLFQ queue level of process pid, or -1 if none.
+int
+get_qlevel(int pid)
+{
+  struct proc *p;
+  int level = -1;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+    if(p->pid == pid && p->state != UNUSED)
+      level = p->queue_level;
+  release(&ptable.lock);
+  return level;
+}
+
