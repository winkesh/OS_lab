+// A4 Q1: SRTF key. A process that never declared a burst (init, sh, a
+// test's parent) is treated as the shortest possible job (key 0): such
+// processes only run briefly before blocking, and this keeps them responsive.
+static int
+srtf_key(struct proc *p)
+{
+  return p->burst_time > 0 ? p->remaining_time : 0;
+}
+
+// A4 Q2: HRRN response ratio = ((wait + burst) * 100) / burst, with
+// wait = ticks - ctime, in integer arithmetic. An undeclared burst counts
+// as 1 tick (shortest job), which also avoids dividing by zero.
+static int
+hrrn_ratio(struct proc *p)
+{
+  int bt = p->burst_time > 0 ? p->burst_time : 1;
+  return ((ticks - p->ctime) + bt) * 100 / bt;
+}
+
+// A4: choose the next RUNNABLE process according to the policy picked at
+// build time (make SCHED=RR|SRTF|HRRN|MLFQ). Caller holds ptable.lock.
+// Returns 0 if nothing is runnable.
+static struct proc*
+pickproc(void)
+{
+  struct proc *p, *best = 0;
+
+#if defined(SCHED_SRTF)
+  // A4 Q1: smallest remaining time wins; ties go to the earlier arrival.
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != RUNNABLE)
+      continue;
+    if(best == 0 || srtf_key(p) < srtf_key(best) ||
+       (srtf_key(p) == srtf_key(best) && p->ctime < best->ctime))
+      best = p;
+  }
+#elif defined(SCHED_HRRN)
+  // A4 Q2: highest response ratio wins; ties go to the earlier arrival.
+  int n = 0;
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != RUNNABLE)
+      continue;
+    if(p->burst_time > 0)
+      n++;
+    if(best == 0 || hrrn_ratio(p) > hrrn_ratio(best) ||
+       (hrrn_ratio(p) == hrrn_ratio(best) && p->ctime < best->ctime))
+      best = p;
+  }
+  // A4 Q2: when two or more jobs with declared bursts compete, log every
+  // candidate's ratio so the choice can be checked.
+  if(n >= 2 && best->burst_time > 0){
+    cprintf("[hrrn] tick %d: picked pid %d |", ticks, best->pid);
+    for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+      if(p->state == RUNNABLE && p->burst_time > 0)
+        cprintf(" pid %d R=%d", p->pid, hrrn_ratio(p));
+    cprintf("\n");
+  }
+#elif defined(SCHED_MLFQ)
+  // A4 Q3: find the highest non-empty queue (lowest level), then take the
+  // first RUNNABLE process of that queue after the one picked last time
+  // from it. Each queue keeps its own round-robin cursor, so picks from
+  // other queues cannot skew the rotation inside a queue.
+  static int next[NQUEUE];
+  int i, level = NQUEUE;
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+    if(p->state == RUNNABLE && p->queue_level < level)
+      level = p->queue_level;
+  if(level == NQUEUE)
+    return 0;
+  for(i = 0; i < NPROC; i++){
+    p = &ptable.proc[(next[level] + i) % NPROC];
+    if(p->state == RUNNABLE && p->queue_level == level){
+      best = p;
+      break;
+    }
+  }
+  next[level] = (best - ptable.proc + 1) % NPROC;
+#else
+  // Round-robin: first RUNNABLE process after the one picked last time.
+  static int next = 0;
+  int i;
+  for(i = 0; i < NPROC; i++){
+    p = &ptable.proc[(next + i) % NPROC];
+    if(p->state == RUNNABLE){
+      best = p;
+      break;
+    }
+  }
+  if(best)
+    next = (best - ptable.proc + 1) % NPROC;
+#endif
+
+  return best;
+}
+
