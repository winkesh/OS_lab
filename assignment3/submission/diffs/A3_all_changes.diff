 //      via swtch back to the scheduler.
+// A3: choose the next RUNNABLE process according to the policy picked at
+// build time (make SCHED=RR|FCFS|PRIORITY|SJF). Caller holds ptable.lock.
+// Returns 0 if nothing is runnable.
+static struct proc*
+pickproc(void)
+{
+  struct proc *p, *best = 0;
+
+#if defined(SCHED_FCFS)
+  // A3 Q1: FCFS - the earliest arrival (smallest ctime) wins, pid breaks ties.
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != RUNNABLE)
+      continue;
+    if(best == 0 || p->ctime < best->ctime ||
+       (p->ctime == best->ctime && p->pid < best->pid))
+      best = p;
+  }
+#elif defined(SCHED_SJF)
+  // A3 Q3: SJF - smallest declared burst wins. A burst of 0 (not set) is
+  // treated as larger than any real burst, so those processes run last.
+  // Ties go to the earlier arrival.
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != RUNNABLE)
+      continue;
+    if(best == 0){
+      best = p;
+      continue;
+    }
+    uint pb = p->burst_time > 0 ? p->burst_time : 0xFFFFFFFF;
+    uint bb = best->burst_time > 0 ? best->burst_time : 0xFFFFFFFF;
+    if(pb < bb || (pb == bb && p->ctime < best->ctime))
+      best = p;
+  }
+#else
+  // Round-robin start point, shared by RR and PRIORITY: scanning starts one
+  // slot after the last process picked, so equal candidates take turns.
+  static int next = 0;
+  int i;
+  for(i = 0; i < NPROC; i++){
+    p = &ptable.proc[(next + i) % NPROC];
+    if(p->state != RUNNABLE)
+      continue;
+#if defined(SCHED_PRIORITY)
+    // A3 Q2: lowest priority number wins; the first one found after the
+    // round-robin start point wins a tie.
+    if(best == 0 || p->priority < best->priority)
+      best = p;
+#else
+    best = p;
+    break;
+#endif
+  }
+  if(best)
+    next = (best - ptable.proc + 1) % NPROC;
+#endif
+
+  return best;
+}
+
