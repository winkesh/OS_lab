-      if(p->state != RUNNABLE)
-        continue;
+    // A3: pick one process using the compiled-in policy.
+    p = pickproc();
+    if(p){
+      p->wait_ticks = 0;       // A3 Q2: it is running, so it stops aging
 
       // Switch to chosen process.  It is the process's job
       // to release ptable.lock and then reacquire it
@@ -355,6 +418,74 @@ scheduler(void)
   }
 }
 
+// A3 Q2: called once per timer tick (from trap() on CPU 0). Every RUNNABLE
+// process that has waited more than AGING_TICKS ticks without running gets
+// its priority number lowered by 1 (i.e. its priority raised), and its wait
+// counter is reset.
+void
+age(void)
+{
+  struct proc *p;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != RUNNABLE)
+      continue;
+    if(++p->wait_ticks > AGING_TICKS){
+      if(p->priority > 1){
+        cprintf("[aging] tick %d: pid %d waited %d ticks, priority %d -> %d\n",
+                ticks, p->pid, p->wait_ticks, p->priority, p->priority - 1);
+        p->priority--;
+      }
+      p->wait_ticks = 0;
+    }
+  }
+  release(&ptable.lock);
+}
+
+// A3 Q2: set the priority (1..20) of process pid. Returns 0, or -1 if the
+// priority is out of range or there is no such process.
+int
+set_priority(int pid, int priority)
+{
+  struct proc *p;
+
+  if(priority < 1 || priority > 20)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid && p->state != UNUSED){
+      p->priority = priority;
+      p->wait_ticks = 0;
+      release(&ptable.lock);
+      return 0;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
+
+// A3 Q3: set the declared burst time (ticks, >= 0; 0 clears it) of process
+// pid. Returns 0, or -1 if bt is negative or there is no such process.
+int
+set_burst(int pid, int bt)
+{
+  struct proc *p;
+
+  if(bt < 0)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid && p->state != UNUSED){
+      p->burst_time = bt;
+      release(&ptable.lock);
+      return 0;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
+
 // Enter scheduler.  Must hold only ptable.lock
 // and have changed proc->state. Saves and restores
 // intena because intena is a property of this
